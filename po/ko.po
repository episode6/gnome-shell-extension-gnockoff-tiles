#: src/prefs.js:343 src/prefs.js:363
msgid "Percentage to leave out as gap when a window is tiled."
msgstr "창이 타일링될 때 간격으로 남겨둘 백분율."

#: src/prefs.js:362
msgid "Pixels to leave out as gap when a window is tiled."
msgstr "선택된 창을 분할할 때 남겨둘 여백을 퍼센트로 지정합니다"

#: src/prefs.js:373
msgid "Gap Size Increments"
msgstr "간격 크기 조정자"

#: src/prefs.js:374
msgid "The change that the shorcuts make in the gap size."
msgstr "바로가기가 간격 크기에 부여하는 변경 사항입니다."

#: src/prefs.js:398
msgid "Enable Additional Bottom Gap"
msgstr "추가 하단 간격 활성화"

#: src/prefs.js:399
msgid "Add an additional gap at the bottom of the screen to prevent dock overlap."
msgstr "도크 오버랩을 방지하기 위해 화면 하단에 추가 간격을 추가합니다."

#: src/prefs.js:411 src/prefs.js:430
msgid "Additional gap size at the bottom of the screen in percentage."
msgstr "화면 하단의 추가 간격 크기(백분율)."

#: src/prefs.js:429
msgid "Additional gap size at the bottom of the screen in pixels."
msgstr "화면 하단의 추가 간격 크기(픽셀)."

#: src/prefs.js:438
msgid "Bottom Gap Main Screen Only"
msgstr "주 화면만 하단 간격"

#: src/prefs.js:439
msgid "Apply the additional bottom gap only on the main screen."
msgstr "주 화면에만 추가 하단 간격 적용."

#: src/prefs.js:463
msgid "Assign shortcuts to the functionalities"
msgstr "기능에 바로가기 할당"

#: src/prefs.js:467
msgid "Override System Workspace Shortcuts"
msgstr "시스템 작업 공간 바로가기 덮어쓰기"

#: src/prefs.js:468
msgid "Replace GNOME's built-in workspace switching and moving shortcuts with the ones configured below. The originals are restored when the override is turned off or the extension is disabled."
msgstr "GNOME에 내장된 작업 공간 전환 및 이동 바로가기를 아래에서 설정한 것으로 바꿉니다. 이 옵션이나 확장을 끄면 원래대로 복원됩니다."

#: src/prefs.js:478
msgid "Linked Resize Modifier"
msgstr "연결된 크기 조절 조합 키"

#: src/prefs.js:479
msgid "The modifier key held while resizing to trigger linked resizing."
msgstr "연결된 크기 조절을 트리거하기 위해 크기를 조절하는 동안 누르고 있는 조합 키입니다."

#: src/prefs.js:489
msgid "Switch to Workspace Left"
msgstr "왼쪽 작업 공간으로 전환"

#: src/prefs.js:490
msgid "Shortcut to switch to the workspace on the left."
msgstr "왼쪽으로 창을 분할하는 단축키를 지정합니다"

#: src/prefs.js:500
msgid "Switch to Workspace Right"
msgstr "오른쪽 작업 공간으로 전환"

#: src/prefs.js:501
msgid "Shortcut to switch to the workspace on the right."
msgstr "오른쪽으로 창을 분할하는 단축키를 지정합니다"

#: src/prefs.js:511
msgid "Move Window to Workspace Left"
msgstr "왼쪽 위로 창을 분할하기"

#: src/prefs.js:512
msgid "Shortcut to move the focused window to the workspace on the left."
msgstr "왼쪽 위로 창을 분할하는 단축키를 지정합니다."

#: src/prefs.js:522
msgid "Move Window to Workspace Right"
msgstr "오른쪽 위로 창을 분할하기"

#: src/prefs.js:523
msgid "Shortcut to move the focused window to the workspace on the right."
msgstr "오른쪽 위로 창을 분할하는 단축키를 지정합니다"

#: src/prefs.js:549
msgid "Align Window to Center"
msgstr "중간에 창 맞추기"

#: src/prefs.js:550
msgid "Shortcut to align the active window to center without resizing it."
msgstr "크기를 조절하지 않고 활성 창을 중앙에 정렬하는 바로가기입니다."

#: src/prefs.js:560
msgid "Maximize Window"
msgstr "창 최대화"

#: src/prefs.js:561
msgid "Shortcut to resize the active window to fill the workspace, respecting the configured gaps."
msgstr "설정된 간격을 유지하면서 활성 창을 작업 공간 전체로 키우는 바로가기입니다."

#: src/prefs.js:572
msgid "Shortcut to increase the gap size."
msgstr "간격 크기를 늘리는 바로가기입니다."

#: src/prefs.js:583
msgid "Shortcut to decrease the gap size."
msgstr "간격 크기를 줄이는 바로가기입니다."

#: src/prefs.js:593
msgid "Tile Window to Top Left"
msgstr "왼쪽 위로 창을 분할하기"

#: src/prefs.js:594
msgid "Shortcut to tile the active window to top left."
msgstr "활성 창을 상단 왼쪽에 타일링하는 바로가기입니다."

#: src/prefs.js:604
msgid "Tile Window to Top Right"
msgstr "오른쪽 위로 창을 분할하기"

#: src/prefs.js:605
msgid "Shortcut to tile the active window to top right."
msgstr "활성 창을 상단 오른쪽에 타일링하는 바로가기입니다."

#: src/prefs.js:616
msgid "Tile Window to Bottom Left"
msgstr "왼쪽 아래로 창을 분할하기"

#: src/prefs.js:617
msgid "Shortcut to tile the active window to bottom left."
msgstr "활성 창을 하단 왼쪽에 타일링하는 바로가기입니다."

#: src/prefs.js:627
msgid "Tile Window to Bottom Right"
msgstr "오른쪽 아래로 창을 분할하기"

#: src/prefs.js:628
msgid "Shortcut to tile the active window to bottom right."
msgstr "활성 창을 하단 오른쪽에 타일링하는 바로가기입니다."

#: src/prefs.js:636
msgid "Move Third-Width Column Left"
msgstr "1/3 너비 열을 왼쪽으로 이동"

#: src/prefs.js:637
msgid "Make the window a third of the screen wide at full height and move it left through the left, center, and right positions."
msgstr "창을 화면 너비의 1/3, 전체 높이로 만들고 왼쪽, 가운데, 오른쪽 위치를 왼쪽 방향으로 이동합니다."

#: src/prefs.js:641
msgid "Move Third-Width Column Right"
msgstr "1/3 너비 열을 오른쪽으로 이동"

#: src/prefs.js:642
msgid "Make the window a third of the screen wide at full height and move it right through the left, center, and right positions."
msgstr "창을 화면 너비의 1/3, 전체 높이로 만들고 왼쪽, 가운데, 오른쪽 위치를 오른쪽 방향으로 이동합니다."

#: src/prefs.js:646
msgid "Move Half-Width Column Left"
msgstr "절반 너비 열을 왼쪽으로 이동"

#: src/prefs.js:647
msgid "Make the window half of the screen wide at full height and move it left through the left, center, and right positions."
msgstr "창을 화면 너비의 절반, 전체 높이로 만들고 왼쪽, 가운데, 오른쪽 위치를 왼쪽 방향으로 이동합니다."

#: src/prefs.js:651
msgid "Move Half-Width Column Right"
msgstr "절반 너비 열을 오른쪽으로 이동"

#: src/prefs.js:652
msgid "Make the window half of the screen wide at full height and move it right through the left, center, and right positions."
msgstr "창을 화면 너비의 절반, 전체 높이로 만들고 왼쪽, 가운데, 오른쪽 위치를 오른쪽 방향으로 이동합니다."

#: src/prefs.js:656
msgid "Move Two-Thirds-Width Column Left"
msgstr "2/3 너비 열을 왼쪽으로 이동"

#: src/prefs.js:657
msgid "Make the window two thirds of the screen wide at full height and move it left through the left, center, and right positions."
msgstr "창을 화면 너비의 2/3, 전체 높이로 만들고 왼쪽, 가운데, 오른쪽 위치를 왼쪽 방향으로 이동합니다."

#: src/prefs.js:661
msgid "Move Two-Thirds-Width Column Right"
msgstr "2/3 너비 열을 오른쪽으로 이동"

#: src/prefs.js:662
msgid "Make the window two thirds of the screen wide at full height and move it right through the left, center, and right positions."
msgstr "창을 화면 너비의 2/3, 전체 높이로 만들고 왼쪽, 가운데, 오른쪽 위치를 오른쪽 방향으로 이동합니다."

#: src/prefs.js:720
msgid "Disabled"
msgstr "비활성화됨"

#: src/prefs.js:731
msgid "About"
msgstr "정보"

#: src/prefs.js:763
msgid "A knockoff of the macOS Tiles app, for GNOME. Tile windows into any corner or into third, half, or two-thirds width columns with keyboard shortcuts, cycle through grid sizes on repeated keystrokes, and resize adjacent tiled windows together. Includes customizable gaps, center alignment, and a tray menu."
msgstr "macOS의 Tiles 앱을 본뜬 GNOME용 확장입니다. 키보드 바로가기로 창을 어느 모서리에나, 또는 1/3, 절반, 2/3 너비의 열로 배치하고, 반복해서 누르면 격자 크기를 순환하며, 인접한 분할 창의 크기를 함께 조절합니다. 사용자 지정 간격, 가운데 맞추기, 트레이 메뉴를 제공합니다."

