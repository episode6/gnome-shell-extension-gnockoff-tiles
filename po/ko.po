msgstr "하단 간격 크기"

#: src/prefs.js:272
msgid "Gap size at the bottom (percent)."
msgstr "하단 간격 크기(백분율)."

#: src/prefs.js:288
msgid "Inner Gap Size"
msgstr "여백 크기 증가시키기"

#: src/prefs.js:289
msgid "Gap size between windows (percent)."
msgstr "윈도우들 사이에 여백을 추가합니다"

