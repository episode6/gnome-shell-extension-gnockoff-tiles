msgstr "Πατήστε τη συντόμευση πληκτρολογίου ή 'Backspace' για απενεργοποίηση..."

#: src/prefs-shortcut-dialog.ui:28
msgid "Keyboard Shortcut"
msgstr "Συντόμευση πληκτρολογίου"
