#: src/panelIndicator.js:127 src/prefs.js:571
msgid "Increase Gap Size"
msgstr "Tussenruimte vergroten"

#: src/panelIndicator.js:128 src/prefs.js:582
msgid "Decrease Gap Size"
msgstr "Tussenruimte verkleinen"

#: src/prefs.js:56 src/prefs.js:88
msgid "Behavior"
msgstr "Gedrag"

#: src/prefs.js:65 src/prefs.js:180
msgid "Gaps"
msgstr "Tussenruimtes"

#: src/prefs.js:74 src/prefs.js:462
msgid "Shortcuts"
msgstr "Sneltoetsen"

#: src/prefs.js:92
msgid "Enable Window Animations"
msgstr "Vensteranimaties inschakelen"

#: src/prefs.js:93
msgid "Animate windows when resized or repositioned (this may be buggy on Wayland)."
msgstr "Vensters animeren bij herdimensioneren of herpositioneren (dit kan afwijkingen vertonen op Wayland)."

#: src/prefs.js:104
msgid "Shortcut Iteration Timeout in Milliseconds"
msgstr "Time-out voor sneltoets-iteratie in milliseconden"

#: src/prefs.js:105
msgid "The time window to consider a new key press an iteration."
msgstr "Het tijdsbestek om een nieuwe toetsaanslag als een iteratie te beschouwen."

#: src/prefs.js:124
msgid "Corner Tiling Steps"
msgstr "Stappen voor hoektegels"

#: src/prefs.js:125
msgid "Steps on each key press (values between 0-1)."
msgstr "Stappen bij elke toetsaanslag (waarden tussen 0-1)."

#: src/prefs.js:137
msgid "Enable Linked Window Resize"
msgstr "Gekoppeld vensterformaat wijzigen inschakelen"

#: src/prefs.js:138
msgid "When holding Alt and resizing a window, adjacent tiled windows will resize together to maintain the gap."
msgstr "Door Alt ingedrukt te houden en een venster te herdimensioneren, zullen aangrenzende getegelde vensters samen herdimensioneren om de tussenruimte te behouden."

#: src/prefs.js:150
msgid "Use theme accent color"
msgstr "Accentkleur van het thema gebruiken"

#: src/prefs.js:154
msgid "Linked Resize Glow Color"
msgstr "Glow-kleur voor gekoppeld formaat wijzigen"

#: src/prefs.js:155
msgid "Custom color for the glow effect during linked resize (hex format like #3584e4). Leave empty to use theme accent color."
msgstr "Aangepaste kleur voor het glow-effect tijdens gekoppeld herdimensioneren (hex-formaat zoals #3584e4). Laat leeg om de accentkleur van het thema te gebruiken."

#: src/prefs.js:184
msgid "Use Pixels for Gap Size"
msgstr "Pixels gebruiken voor tussenruimte"

#: src/prefs.js:185
msgid "Use pixels instead of percentage for gap size."
msgstr "Pixels gebruiken in plaats van percentage voor de tussenruimte."

#: src/prefs.js:196
msgid "Gaps Between Windows"
msgstr "Tussenruimtes tussen vensters"

#: src/prefs.js:197
msgid "Put gaps between windows."
msgstr "Plaats tussenruimtes tussen vensters."

#: src/prefs.js:208
msgid "Enable Individual Gap Sizes"
msgstr "Individuele tussenruimte-groottes inschakelen"

#: src/prefs.js:209
msgid "Configure separate gap sizes for each side (top, left, bottom, right) and between windows."
msgstr "Configureer afzonderlijke tussenruimte-groottes voor elke kant (boven, links, onder, rechts) en tussen vensters."

#: src/prefs.js:220
msgid "Top Gap Size"
msgstr "Tussenruimte bovenaan"

#: src/prefs.js:221
msgid "Gap size at the top (percent)."
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:237
msgid "Left Gap Size"
msgstr "Tussenruimte vergroten"

#: src/prefs.js:238
msgid "Gap size at the left (percent)."
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:254
msgid "Right Gap Size"
msgstr "Tussenruimte rechts"

#: src/prefs.js:255
msgid "Gap size at the right (percent)."
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:271 src/prefs.js:410
msgid "Bottom Gap Size"
msgstr "Grootte van onderste tussenruimte"

#: src/prefs.js:272
msgid "Gap size at the bottom (percent)."
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:288
msgid "Inner Gap Size"
msgstr "Tussenruimte vergroten"

#: src/prefs.js:289
msgid "Gap size between windows (percent)."
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:324
msgid "pixels"
msgstr "pixels"

#: src/prefs.js:324
msgid "percent"
msgstr "procent"

#: src/prefs.js:325
msgid "Gap size at the top"
msgstr "Tussenruimte bovenaan"

#: src/prefs.js:326
msgid "Gap size at the left"
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:327
msgid "Gap size at the right"
msgstr "Tussenruimte: %d procent"

#: src/prefs.js:328
msgid "Gap size at the bottom"
msgstr "Tussenruimte onderaan"

#: src/prefs.js:329
msgid "Gap size between windows"
msgstr "Ruimte tussen venster en werkblad"

#: src/prefs.js:342
msgid "Gap Between Window and Workspace"
msgstr "Ruimte tussen venster en werkblad"

#: src/prefs.js:343 src/prefs.js:363
msgid "Percentage to leave out as gap when a window is tiled."
msgstr "Percentage dat als tussenruimte wordt vrijgelaten wanneer een venster wordt getegeld."

#: src/prefs.js:362
msgid "Pixels to leave out as gap when a window is tiled."
msgstr "De te reserveren tussenruimte (in procenten) als een venster gefocust en getegeld is."

#: src/prefs.js:373
msgid "Gap Size Increments"
msgstr "Stappen voor tussenruimte-grootte"

#: src/prefs.js:374
msgid "The change that the shorcuts make in the gap size."
msgstr "De verandering die de sneltoetsen maken in de tussenruimte."

#: src/prefs.js:398
msgid "Enable Additional Bottom Gap"
msgstr "Extra tussenruimte onderaan inschakelen"

#: src/prefs.js:399
msgid "Add an additional gap at the bottom of the screen to prevent dock overlap."
msgstr "Voeg een extra tussenruimte toe aan de onderkant van het scherm om overlap met het dock te voorkomen."

#: src/prefs.js:411 src/prefs.js:430
msgid "Additional gap size at the bottom of the screen in percentage."
msgstr "Extra tussenruimte aan de onderkant van het scherm in procenten."

#: src/prefs.js:429
msgid "Additional gap size at the bottom of the screen in pixels."
msgstr "Extra tussenruimte aan de onderkant van het scherm in pixels."

#: src/prefs.js:438
msgid "Bottom Gap Main Screen Only"
msgstr "Onderste tussenruimte alleen op hoofdscherm"

#: src/prefs.js:439
msgid "Apply the additional bottom gap only on the main screen."
msgstr "De extra tussenruimte onderaan alleen op het hoofdscherm toepassen."

#: src/prefs.js:463
msgid "Assign shortcuts to the functionalities"
msgstr "Sneltoetsen toewijzen aan de functionaliteiten"

#: src/prefs.js:467
msgid "Override System Workspace Shortcuts"
msgstr "Systeemsneltoetsen voor werkbladen overschrijven"

#: src/prefs.js:468
msgid "Replace GNOME's built-in workspace switching and moving shortcuts with the ones configured below. The originals are restored when the override is turned off or the extension is disabled."
msgstr "Vervangt de ingebouwde GNOME-sneltoetsen voor het wisselen van werkblad en het verplaatsen van vensters door de hieronder ingestelde. De originele worden hersteld wanneer deze optie of de extensie wordt uitgeschakeld."

#: src/prefs.js:478
msgid "Linked Resize Modifier"
msgstr "Modificatietoets voor gekoppeld formaat wijzigen"

#: src/prefs.js:479
msgid "The modifier key held while resizing to trigger linked resizing."
msgstr "De modificatietoets die wordt ingedrukt tijdens het wijzigen van het formaat om gekoppeld herdimensioneren te activeren."

#: src/prefs.js:489
msgid "Switch to Workspace Left"
msgstr "Naar linker werkruimte gaan"

#: src/prefs.js:490
msgid "Shortcut to switch to the workspace on the left."
msgstr "De sneltoets waarmee een gefocust venster aan de linkerkant van het scherm kan worden getegeld."

#: src/prefs.js:500
msgid "Switch to Workspace Right"
msgstr "Naar rechter werkruimte gaan"

#: src/prefs.js:501
msgid "Shortcut to switch to the workspace on the right."
msgstr "De sneltoets waarmee een gefocust venster aan de rechterkant van het scherm kan worden getegeld."

#: src/prefs.js:511
msgid "Move Window to Workspace Left"
msgstr "Venster linksboven tegelen"

#: src/prefs.js:512
msgid "Shortcut to move the focused window to the workspace on the left."
msgstr "De sneltoets waarmee een gefocust venster linksboven op het scherm kan worden getegeld."

#: src/prefs.js:522
msgid "Move Window to Workspace Right"
msgstr "Venster rechtsboven tegelen"

#: src/prefs.js:523
msgid "Shortcut to move the focused window to the workspace on the right."
msgstr "De sneltoets waarmee een gefocust venster rechtsboven op het scherm kan worden getegeld."

#: src/prefs.js:549
msgid "Align Window to Center"
msgstr "Venster centreren"

#: src/prefs.js:550
msgid "Shortcut to align the active window to center without resizing it."
msgstr "Sneltoets om het actieve venster te centreren zonder het formaat te wijzigen."

#: src/prefs.js:560
msgid "Maximize Window"
msgstr "Venster maximaliseren"

#: src/prefs.js:561
msgid "Shortcut to resize the active window to fill the workspace, respecting the configured gaps."
msgstr "Sneltoets om het actieve venster het hele werkblad te laten vullen, met inachtneming van de ingestelde tussenruimtes."

#: src/prefs.js:572
msgid "Shortcut to increase the gap size."
msgstr "Sneltoets om de tussenruimte te vergroten."

#: src/prefs.js:583
msgid "Shortcut to decrease the gap size."
msgstr "Sneltoets om de tussenruimte te verkleinen."

#: src/prefs.js:593
msgid "Tile Window to Top Left"
msgstr "Venster linksboven tegelen"

#: src/prefs.js:594
msgid "Shortcut to tile the active window to top left."
msgstr "Sneltoets om het actieve venster linksboven zu te tegelen."

#: src/prefs.js:604
msgid "Tile Window to Top Right"
msgstr "Venster rechtsboven tegelen"

#: src/prefs.js:605
msgid "Shortcut to tile the active window to top right."
msgstr "Sneltoets om het actieve venster rechtsboven zu te tegelen."

#: src/prefs.js:616
msgid "Tile Window to Bottom Left"
msgstr "Venster linksonder tegelen"

#: src/prefs.js:617
msgid "Shortcut to tile the active window to bottom left."
msgstr "Sneltoets om het actieve venster linksonder zu te tegelen."

#: src/prefs.js:627
msgid "Tile Window to Bottom Right"
msgstr "Venster rechtsonder tegelen"

#: src/prefs.js:628
msgid "Shortcut to tile the active window to bottom right."
msgstr "Sneltoets om het actieve venster rechtsonder zu te tegelen."

#: src/prefs.js:636
msgid "Move Third-Width Column Left"
msgstr "Kolom van een derde naar links"

#: src/prefs.js:637
msgid "Make the window a third of the screen wide at full height and move it left through the left, center, and right positions."
msgstr "Maakt het venster een derde van het scherm breed op volledige hoogte en verplaatst het naar links door de posities links, midden en rechts."

#: src/prefs.js:641
msgid "Move Third-Width Column Right"
msgstr "Kolom van een derde naar rechts"

#: src/prefs.js:642
msgid "Make the window a third of the screen wide at full height and move it right through the left, center, and right positions."
msgstr "Maakt het venster een derde van het scherm breed op volledige hoogte en verplaatst het naar rechts door de posities links, midden en rechts."

#: src/prefs.js:646
msgid "Move Half-Width Column Left"
msgstr "Kolom van halve breedte naar links"

#: src/prefs.js:647
msgid "Make the window half of the screen wide at full height and move it left through the left, center, and right positions."
msgstr "Maakt het venster half zo breed als het scherm op volledige hoogte en verplaatst het naar links door de posities links, midden en rechts."

#: src/prefs.js:651
msgid "Move Half-Width Column Right"
msgstr "Kolom van halve breedte naar rechts"

#: src/prefs.js:652
msgid "Make the window half of the screen wide at full height and move it right through the left, center, and right positions."
msgstr "Maakt het venster half zo breed als het scherm op volledige hoogte en verplaatst het naar rechts door de posities links, midden en rechts."

#: src/prefs.js:656
msgid "Move Two-Thirds-Width Column Left"
msgstr "Kolom van twee derde naar links"

#: src/prefs.js:657
msgid "Make the window two thirds of the screen wide at full height and move it left through the left, center, and right positions."
msgstr "Maakt het venster twee derde van het scherm breed op volledige hoogte en verplaatst het naar links door de posities links, midden en rechts."

#: src/prefs.js:661
msgid "Move Two-Thirds-Width Column Right"
msgstr "Kolom van twee derde naar rechts"

#: src/prefs.js:662
msgid "Make the window two thirds of the screen wide at full height and move it right through the left, center, and right positions."
msgstr "Maakt het venster twee derde van het scherm breed op volledige hoogte en verplaatst het naar rechts door de posities links, midden en rechts."

#: src/prefs.js:720
msgid "Disabled"
msgstr "Uitgeschakeld"

#: src/prefs.js:731
msgid "About"
msgstr "Over"

#: src/prefs.js:763
msgid "A knockoff of the macOS Tiles app, for GNOME. Tile windows into any corner or into third, half, or two-thirds width columns with keyboard shortcuts, cycle through grid sizes on repeated keystrokes, and resize adjacent tiled windows together. Includes customizable gaps, center alignment, and a tray menu."
msgstr "Een namaak van de macOS-app Tiles, voor GNOME. Tegel vensters met sneltoetsen in elke hoek of in kolommen van een derde, de helft of twee derde van de breedte, doorloop rastergroottes met herhaalde toetsaanslagen en wijzig het formaat van aangrenzende getegelde vensters tegelijk. Met instelbare tussenruimtes, centreren en een menu in de balk."

